+    text-align: inherit;
+}
+
+.withUnderline {
+    --inline-element-line-height: calc(
+        var(--font-text-m-regular-line-height) + var(--inline-element-underline-height) +
+            var(--inline-element-underline-gap)
+    );
+}
+
+.clickable {
+    cursor: pointer;
+}
+
+@media (hover: hover) {
+    .clickable:hover {
+        opacity: 0.64;
+    }
+}
+
+.clickable:active {
+    opacity: 0.78;
+}
+
+.root:focus-visible {
+    border-radius: var(--corner-radius-3xs);
+    outline: var(--line-thickness-default) solid var(--color-stroke-standard-brand-main);
+}
+
+.content {
+    position: relative;
+    display: inline-flex;
+    align-items: baseline;
+    max-width: 100%;
+}
+
+.leading {
+    position: relative;
+    display: inline-flex;
+    flex: 0 0 auto;
+    align-self: flex-start;
+    align-items: center;
+    justify-content: center;
+    width: var(--icon-size-s);
+    height: var(--icon-size-s);
+    margin-top: var(--inline-element-icon-offset);
+    margin-right: var(--spacing-gap-horizontal-xs);
+    color: var(--inline-element-leading-color, var(--color-icon-standard-general-primary));
+}
+
+.leading > :global(svg) {
+    display: block;
+    width: 100%;
+    height: 100%;
+}
+
+/* Иконка занимает свою колонку: строки переноса выравниваются по началу текста, а не уходят под иконку */
+.textWrapper {
+    position: relative;
+    display: block;
+    min-width: 0;
+    line-height: var(--inline-element-line-height);
