+import { useCallback } from 'react'
+import { ArrowTopRightIcon } from '@sbol/asdk-icons'
+
+import { useSystemActions } from '#/hooks'
+import { InlineElement, InlineIcon, normalizeInlineAction } from '#/parts/inline-element'
+import { widget, type Widget } from '#/system'
+
+import { type PayloadData } from './link.schema'
+
+// Ссылка не зависит от активности сообщения: переход можно открыть и из старого ответа
+export const Link: Widget<PayloadData> = ({ data }) => {
+    const { action, loading } = useSystemActions()
+
+    const handleClick = useCallback(() => {
+        if (loading) {
+            return
+        }
+
+        // action переопределяет переход по url
+        void action(
+            normalizeInlineAction(data.action ?? { type: 'deeplink', payload: { url: data.url } }, {
+                from: 'link',
+                inputType: 'widget'
+            })
+        )
+    }, [action, data.action, data.url, loading])
+
+    return (
+        <InlineElement
+            text={data.text}
+            leading={data.icon ? <InlineIcon icon={data.icon} /> : <ArrowTopRightIcon />}
+            underline
+            role="link"
+            disabled={loading}
+            onClick={handleClick}
+        />
+    )
+}
+
+export default widget(Link, { withModule: false, wrapperElement: 'span' })
