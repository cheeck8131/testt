+import { render, screen } from '@testing-library/react'
+import { describe, expect, it } from 'vitest'
+
+import CaretDownIcon from '#/assets/components/caret-down-icon'
+import CaretUpIcon from '#/assets/components/caret-up-icon'
+
+import { ERROR_TEXT } from './accessibility'
+import { InlineTicket } from './inline-ticket'
+import { examples } from './inline-ticket.examples'
+import { PayloadDataSchema } from './inline-ticket.schema'
+import Styles from './inline-ticket.module.css'
+
+const getExample = (name: string) => {
+    const example = examples.find((item) => item.name === name)
+
+    if (!example) {
+        throw new Error(`Пример ${name} не найден`)
+    }
+
+    return example.params
+}
+
+// Контур треугольника, по которому отличаем ic_16_caret_up от ic_16_caret_down
+const getIconPath = (element: Element | null) => element?.querySelector('path')?.getAttribute('d')
+
+describe('InlineTicket', () => {
+    it('все примеры проходят схему', () => {
+        examples.forEach((example) => {
+            expect(PayloadDataSchema.safeParse(example.params).success, example.name).toBe(true)
+        })
+    })
+
+    it('при росте показывает зелёное значение со стрелкой «рост»', () => {
+        const data = getExample('InlineTicketPositive')
+
+        render(<InlineTicket data={data} />)
+        const trend = screen.getByRole('img', { name: 'рост' })
+
+        expect(screen.getByText(data.text)).toBeInTheDocument()
+        expect(getIconPath(trend)).toBe(getIconPath(render(<CaretUpIcon />).container))
+        expect(trend.parentElement).toHaveClass(Styles.positive)
+        expect(trend.parentElement).toHaveTextContent('2,4%')
+    })
+
+    it('при падении показывает красное значение со стрелкой «падение»', () => {
+        render(<InlineTicket data={getExample('InlineTicketNegative')} />)
+        const trend = screen.getByRole('img', { name: 'падение' })
+
+        expect(getIconPath(trend)).toBe(getIconPath(render(<CaretDownIcon />).container))
+        expect(trend.parentElement).toHaveClass(Styles.negative)
+    })
+
+    it('без изменений показывает значение без стрелки', () => {
+        render(<InlineTicket data={getExample('InlineTicketNeutral')} />)
+
+        expect(screen.getByText('0,0%')).toBeInTheDocument()
+        expect(screen.queryByRole('img')).not.toBeInTheDocument()
+    })
+
+    it('при kind=Error показывает «Данные не пришли» вместо котировки', () => {
+        render(<InlineTicket data={getExample('InlineTicketError')} />)
+
+        expect(screen.getByText(ERROR_TEXT)).toBeInTheDocument()
+        expect(screen.queryByText('LKOH')).not.toBeInTheDocument()
+    })
+
+    it.each(['', '   ', undefined])('без значения изменения (%j) показывает «Данные не пришли»', (change?: string) => {
+        render(<InlineTicket data={{ text: 'SBER', kind: 'Positive', change }} />)
+
+        expect(screen.getByText(ERROR_TEXT)).toBeInTheDocument()
+        expect(screen.queryByRole('img', { name: 'рост' })).not.toBeInTheDocument()
+    })
+})
