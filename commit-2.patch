@@ -0,0 +1,52 @@
+import clsx from 'clsx'
+import { WarningIcon } from '@sbol/asdk-icons'
+
+import TrendIcon from '#/assets/components/trend-icon'
+import { InlineElement, InlineIcon } from '#/parts/inline-element'
+import { widget, type Widget } from '#/system'
+
+import { ERROR_TEXT, getTrendLabel } from './accessibility'
+import Styles from './inline-ticket.module.css'
+import { type PayloadData, type TicketKind } from './inline-ticket.schema'
+
+type ChangeKind = Exclude<TicketKind, 'Error'>
+
+const CHANGE_CLASS_NAME: Record<ChangeKind, string | undefined> = {
+    Neutral: undefined,
+    Positive: Styles.positive,
+    Negative: Styles.negative
+}
+
+// Без значения изменения котировку показать нельзя — это то же состояние, что и Error
+const resolveTicketKind = (data: PayloadData): TicketKind =>
+    data.kind === 'Error' || !data.change?.trim() ? 'Error' : (data.kind ?? 'Neutral')
+
+export const InlineTicket: Widget<PayloadData> = ({ data }) => {
+    const kind = resolveTicketKind(data)
+
+    if (kind === 'Error') {
+        return <InlineElement text={ERROR_TEXT} leading={<WarningIcon />} className={Styles.error} />
+    }
+
+    const trendLabel = getTrendLabel(kind)
+    const trailing = (
+        <span className={clsx(Styles.change, CHANGE_CLASS_NAME[kind])}>
+            {trendLabel ? (
+                <span role="img" aria-label={trendLabel} className={Styles.trend}>
+                    <TrendIcon direction={kind === 'Positive' ? 'up' : 'down'} aria-hidden="true" focusable="false" />
+                </span>
+            ) : null}
+            {data.change}
+        </span>
+    )
+
+    return (
+        <InlineElement
+            text={data.text}
+            leading={data.icon ? <InlineIcon icon={data.icon} /> : undefined}
+            trailing={trailing}
+        />
+    )
+}
+
+export default widget(InlineTicket, { withModule: false, wrapperElement: 'span' })
