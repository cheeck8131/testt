+import { z } from 'zod'
+
+import { InlineActionSchema } from '#/parts/inline-element/inline-element.schema'
+
+export const CheckActiveSchema = z
+    .object({
+        methodName: z
+            .string()
+            .describe('Имя внешнего метода хоста, который отвечает, можно ли ещё выполнить действие, например checkActiveId'),
+        // passthrough вместо record: additionalProperties: {} валидатор GigaChat считает нетипизированным узлом
+        methodParams: z
+            .object({})
+            .passthrough()
+            .optional()
+            .describe(
+                'Параметры внешнего метода, по которым хост находит событие, например { "eventId": "1234567" }. ' +
+                    'Если не переданы, метод вызывается с пустым объектом'
+            )
+    })
+    .describe(
+        'Проверка активности действия через внешний метод хоста. Метод возвращает true/false или строку "true"/"false". ' +
+            'Пока идёт проверка, действие неактивно. Действие становится неактивным только при ответе false; ' +
+            'если метода нет, он упал или ответ непонятен, действие активно. После выполнения action проверка повторяется'
+    )
+
+export const PayloadDataSchema = z
+    .object({
+        text: z
+            .string()
+            .describe(
+                'Текст действия внутри предложения — фраза с глаголом, например «проанализировать траты» или «перейти к регистрации»'
+            ),
+        action: InlineActionSchema.optional().describe(
+            'Действие по нажатию: message — отправить сообщение в чат от имени пользователя (content уходит агенту ' +
+                'в function_results), deeplink — открыть экран, externalMethod — вызвать метод хоста. ' +
+                'Если не передано, в чат отправляется text'
+        ),
+        inactiveAfterSend: z
+            .boolean()
+            .optional()
+            .describe(
+                'Сделать действие неактивным после первого нажатия. Используй для однократных действий, ' +
+                    'чтобы избежать дублирования запроса и ошибок при повторном нажатии. По умолчанию false. ' +
+                    'Состояние НЕ СОХРАНЯЕТСЯ НИГДЕ: после перезахода в чат действие снова станет активным. ' +
+                    'Чтобы неактивность сохранялась, используй checkActive — externalMethod своего API в web/iOS/Android, ' +
+                    'который вернёт false для уже выполненного действия'
+            ),
+        checkActive: CheckActiveSchema.optional().describe(
+            'Проверка на стороне хоста, актуально ли ещё действие. Используй, когда действие привязано к событию, ' +
+                'которое может устареть или уже быть выполнено в другом месте. Если не передано, действие активно сразу'
+        )
+    })
+    .describe(
+        'Действие внутри текста ответа: стрелка ↳ и фраза с глаголом с подчёркиванием. ' +
+            'По нажатию выполняет action, по умолчанию отправляет text в чат от имени пользователя'
+    )
+
+export type CheckActive = z.infer<typeof CheckActiveSchema>
+export type PayloadData = z.infer<typeof PayloadDataSchema>
