diff --git a/src/assets/components/trend-icon.tsx b/src/assets/components/trend-icon.tsx
new file mode 100644
index 0000000..488fdb5
--- /dev/null
+++ b/src/assets/components/trend-icon.tsx
@@ -0,0 +1,25 @@
+import type { Ref, SVGProps } from 'react'
+import { forwardRef } from 'react'
+
+import CaretDownIcon from './caret-down-icon'
+import CaretUpIcon from './caret-up-icon'
+
+type TrendIconProps = SVGProps<SVGSVGElement> & {
+    /** Направление тренда: up — рост, down — падение */
+    direction: 'up' | 'down'
+}
+
+/**
+ * ic_trend: стрелка направления котировки для inline-виджетов.
+ * Внутри ic_16_caret_up и ic_16_caret_down, обрезанные по ширине до треугольника (8×16),
+ * чтобы стрелка стояла вплотную к значению, а не в квадрате 16×16.
+ */
+const TrendIcon = ({ direction, ...props }: TrendIconProps, ref: Ref<SVGSVGElement>) => {
+    const CaretIcon = direction === 'up' ? CaretUpIcon : CaretDownIcon
+
+    return <CaretIcon viewBox="4 0 8 16" width="0.5em" height="1em" ref={ref} {...props} />
+}
+
+const ForwardRef = forwardRef(TrendIcon)
+
+export default ForwardRef
diff --git a/src/parts/inline-element/CHANGELOG.md b/src/parts/inline-element/CHANGELOG.md
