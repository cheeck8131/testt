+import { z } from 'zod'
+
+import { InlineActionSchema, InlineIconSchema } from '#/parts/inline-element/inline-element.schema'
+
+export const PayloadDataSchema = z
+    .object({
+        text: z.string().describe('Текст ссылки внутри предложения, например «Рейтинг» или «условия вклада»'),
+        url: z.string().describe('URL страницы или диплинк экрана приложения, который откроется по нажатию'),
+        action: InlineActionSchema.optional().describe(
+            'Действие по нажатию вместо открытия url: message — отправить сообщение в чат, deeplink — открыть экран, ' +
+                'externalMethod — вызвать метод хоста. Передавай, только если простого перехода по url недостаточно'
+        ),
+        icon: InlineIconSchema.optional().describe(
+            'Иконка слева от текста. Если не передана — стрелка ↗. Для ссылки на сервис или компанию передай логотип по URL'
+        )
+    })
+    .describe(
+        'Ссылка внутри текста ответа: иконка слева и текст с подчёркиванием. ' +
+            'По нажатию открывает URL или диплинк либо выполняет action'
+    )
+
+export type PayloadData = z.infer<typeof PayloadDataSchema>
