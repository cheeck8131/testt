+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { SendMessage } from './send-message'
+import { examples } from './send-message.examples'
+import { PayloadDataSchema } from './send-message.schema'
+import Styles from './send-message.module.css'
+
+const mocks = vi.hoisted(() => ({
+    action: vi.fn(),
+    hostActive: true,
+    getExternalMethod: null as unknown
+}))
+
+// Активность хоста управляется из теста, локальная блокировка работает как в useWidgetActive
+vi.mock('#/hooks', async () => {
+    const { useState } = await import('react')
+
+    return {
+        useSystemActions: () => ({ action: mocks.action, loading: false }),
+        useWidgetActive: () => {
+            const [isDisabled, setDisabled] = useState(false)
+
+            return { isActive: mocks.hostActive && !isDisabled, setDisabled }
+        },
+        useGetExternalMethod: () => mocks.getExternalMethod
+    }
+})
+
+const getExample = (name: string) => {
+    const example = examples.find((item) => item.name === name)
+
+    if (!example) {
+        throw new Error(`Пример ${name} не найден`)
+    }
+
+    return example.params
+}
+
+const createDeferred = <T,>() => {
+    let resolve: (value: T) => void = () => undefined
+    const promise = new Promise<T>((res) => {
+        resolve = res
+    })
+
+    return { promise, resolve }
+}
+
+/** Подключает мок хоста, где checkActiveId отвечает значениями по очереди */
+const mockCheckActive = (...responses: unknown[]) => {
+    const checkActiveMethod = vi.fn()
+
+    responses.forEach((response) => checkActiveMethod.mockResolvedValueOnce(response))
+    mocks.getExternalMethod = vi.fn(async (methodName: string) =>
+        methodName === 'checkActiveId' ? checkActiveMethod : undefined
+    )
+
+    return checkActiveMethod
+}
+
+describe('SendMessage', () => {
+    beforeEach(() => {
+        mocks.action.mockReset()
+        mocks.hostActive = true
+        mocks.getExternalMethod = null
+    })
+
+    it('все примеры проходят схему', () => {
+        examples.forEach((example) => {
+            expect(PayloadDataSchema.safeParse(example.params).success, example.name).toBe(true)
+        })
+    })
+
+    it('выполняет action message с content и именем виджета по нажатию', () => {
+        const data = getExample('SendMessageWithContent')
+
+        render(<SendMessage data={data} />)
+        fireEvent.click(screen.getByRole('button', { name: data.text }))
+
+        expect(mocks.action).toHaveBeenCalledWith({
+            type: 'message',
+            from: 'send_message',
+            payload: {
+                text: 'Включи накопительный счёт в прогноз',
+                content: '{"accountType":"savings","withdrawable":true}',
+                inputType: 'widget'
+            }
+        })
+    })
+
+    it('без action отправляет text', () => {
+        const data = getExample('SendMessageTextAsMessage')
+
+        render(<SendMessage data={data} />)
+        fireEvent.click(screen.getByRole('button', { name: data.text }))
+
+        expect(mocks.action).toHaveBeenCalledWith({
+            type: 'message',
+            from: 'send_message',
+            payload: { text: data.text, inputType: 'widget' }
+        })
+    })
+
+    it('выполняет action externalMethod', () => {
+        const data = getExample('SendMessageExternalMethodCheckActive')
+
+        render(<SendMessage data={{ ...data, checkActive: undefined }} />)
+        fireEvent.click(screen.getByRole('button', { name: data.text }))
+
+        expect(mocks.action).toHaveBeenCalledWith({
+            type: 'externalMethod',
+            from: 'send_message',
+            payload: {
+                externalMethodSettings: {
+                    methodName: 'confirmEvent',
+                    methodParams: { eventId: '1234567' },
+                    callbackType: 'none'
+                }
+            }
+        })
+    })
+
+    it('без inactiveAfterSend остаётся активным после отправки', () => {
+        const data = getExample('SendMessageDefault')
+
+        render(<SendMessage data={data} />)
+        const button = screen.getByRole('button', { name: data.text })
+
+        fireEvent.click(button)
+        fireEvent.click(button)
+
+        expect(mocks.action).toHaveBeenCalledTimes(2)
+        expect(button).toBeEnabled()
+    })
+
+    it('с inactiveAfterSend отправляет сообщение один раз и становится неактивным', () => {
+        const data = getExample('SendMessageInactiveAfterSend')
+
+        render(<SendMessage data={data} />)
+        const button = screen.getByRole('button', { name: data.text })
+
+        fireEvent.click(button)
+        fireEvent.click(button)
+
+        expect(mocks.action).toHaveBeenCalledTimes(1)
+        expect(button).toBeDisabled()
+        expect(button).toHaveClass(Styles.inactive)
+    })
+
+    it('с inactiveAfterSend не отправляет дубль при двух нажатиях до ре-рендера', () => {
+        const data = getExample('SendMessageInactiveAfterSend')
+
+        render(<SendMessage data={data} />)
+        const button = screen.getByRole('button', { name: data.text })
+
+        // Оба клика в одном act: обновление состояния применится только после второго
+        act(() => {
+            button.click()
+            button.click()
+        })
+
+        expect(mocks.action).toHaveBeenCalledTimes(1)
+    })
+
+    it('в неактивном сообщении не отправляет сообщение и выглядит неактивным', () => {
+        mocks.hostActive = false
+        const data = getExample('SendMessageDefault')
+
+        render(<SendMessage data={data} />)
+        const button = screen.getByRole('button', { name: data.text })
+
+        fireEvent.click(button)
+
+        expect(mocks.action).not.toHaveBeenCalled()
+        expect(button).toBeDisabled()
+        expect(button).toHaveClass(Styles.inactive)
+    })
+
+    describe('checkActive', () => {
+        it('без поддержки внешних методов активен сразу', () => {
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+
+            expect(screen.getByRole('button', { name: data.text })).toBeEnabled()
+        })
+
+        it('неактивен, пока идёт проверка, и активируется по ответу true', async () => {
+            const deferred = createDeferred<unknown>()
+            const checkActiveMethod = vi.fn(() => deferred.promise)
+
+            mocks.getExternalMethod = vi.fn(async () => checkActiveMethod)
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+            const button = screen.getByRole('button', { name: data.text })
+
+            expect(button).toBeDisabled()
+            expect(button).toHaveClass(Styles.inactive)
+
+            fireEvent.click(button)
+            expect(mocks.action).not.toHaveBeenCalled()
+
+            await act(async () => {
+                deferred.resolve(true)
+            })
+
+            expect(mocks.getExternalMethod).toHaveBeenCalledWith('checkActiveId')
+            expect(checkActiveMethod).toHaveBeenCalledWith({ eventId: '1234567' })
+            expect(button).toBeEnabled()
+            expect(button).not.toHaveClass(Styles.inactive)
+        })
+
+        it.each([[false], ['false'], [' FALSE ']])('становится неактивным по ответу %j', async (response) => {
+            mockCheckActive(response)
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+            const button = screen.getByRole('button', { name: data.text })
+
+            await waitFor(() => expect(button).toHaveClass(Styles.inactive))
+            fireEvent.click(button)
+
+            expect(button).toBeDisabled()
+            expect(mocks.action).not.toHaveBeenCalled()
+        })
+
+        it.each([['true'], [undefined], [null], ['непонятно']])('активен по ответу %j', async (response) => {
+            mockCheckActive(response)
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+
+            await waitFor(() => expect(screen.getByRole('button', { name: data.text })).toBeEnabled())
+        })
+
+        it('активен, если метод не найден', async () => {
+            const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+
+            mocks.getExternalMethod = vi.fn(async () => undefined)
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+
+            await waitFor(() => expect(screen.getByRole('button', { name: data.text })).toBeEnabled())
+            errorSpy.mockRestore()
+        })
+
+        it('активен, если метод упал', async () => {
+            const errorSpy = vi.spyOn(console, 'error').mockImplementation(() => undefined)
+
+            mocks.getExternalMethod = vi.fn(async () => vi.fn().mockRejectedValue(new Error('host error')))
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+
+            await waitFor(() => expect(screen.getByRole('button', { name: data.text })).toBeEnabled())
