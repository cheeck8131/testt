+            expect(checkActiveMethod).toHaveBeenCalledTimes(1)
+
+            await act(async () => {
+                actionDeferred.resolve()
+            })
+
+            await waitFor(() => expect(checkActiveMethod).toHaveBeenCalledTimes(2))
+            await waitFor(() => expect(button).toHaveClass(Styles.inactive))
+            expect(button).toBeDisabled()
+        })
+
+        it('после повторной проверки с ответом true остаётся активным', async () => {
+            const checkActiveMethod = mockCheckActive(true, true)
+            const data = getExample('SendMessageCheckActive')
+
+            render(<SendMessage data={data} />)
+            const button = screen.getByRole('button', { name: data.text })
+
+            await waitFor(() => expect(button).toBeEnabled())
+            fireEvent.click(button)
+
+            await waitFor(() => expect(checkActiveMethod).toHaveBeenCalledTimes(2))
+            await waitFor(() => expect(button).toBeEnabled())
+        })
+
+        it('с inactiveAfterSend не проверяет активность повторно', async () => {
+            const checkActiveMethod = mockCheckActive(true, true)
+            const data = { ...getExample('SendMessageCheckActive'), inactiveAfterSend: true }
+
+            render(<SendMessage data={data} />)
+            const button = screen.getByRole('button', { name: data.text })
+
+            await waitFor(() => expect(button).toBeEnabled())
+            await act(async () => {
+                fireEvent.click(button)
