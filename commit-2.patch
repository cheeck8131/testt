+import ImageErrorIcon from '#/assets/components/image-error-icon'
+import { IconLoader } from '#/parts/icon-loader'
+import { getSystemIconComponent } from '#/parts/system-icon/icon-registry'
+
+import Styles from './inline-element.module.css'
+import type { InlineIconData } from './inline-element.schema'
+
+type InlineIconProps = {
+    icon: InlineIconData
+}
+
+const fallbackIcon = <ImageErrorIcon color="currentColor" />
+
+/**
+ * Иконка для слота leading: системная по имени или скруглённая картинка по URL.
+ * Если картинка не загрузилась или имя неизвестно, показывает ImageErrorIcon.
+ */
+export const InlineIcon = ({ icon }: InlineIconProps) => {
+    if (icon.type === 'url') {
+        return (
+            <span className={Styles.image}>
+                <IconLoader as="span" iconUrl={icon.url} className={Styles.remoteIcon} fallbackIcon={fallbackIcon} />
+            </span>
+        )
+    }
+
+    const IconComponent = getSystemIconComponent(icon.name)
+
+    return IconComponent ? <IconComponent color="currentColor" /> : fallbackIcon
+}
diff --git a/src/parts/inline-element/use-inline-underline.ts b/src/parts/inline-element/use-inline-underline.ts
new file mode 100644
index 0000000..89d618e
--- /dev/null
+++ b/src/parts/inline-element/use-inline-underline.ts
@@ -0,0 +1,152 @@
+// Замер строк повторяет src/widgets/inline/use-inline-underline.ts:
+// виджеты не импортируют друг друга, поэтому база inline-виджетов вынесена в part.
+// В отличие от inline, линия прямая (по макету), без случайных рукописных вариантов.
+import { useCallback, useLayoutEffect, useState, type RefObject } from 'react'
+
+export type InlineLineRect = {
+    left: number
+    top: number
+    width: number
+}
+
+type UseInlineUnderlineParams = {
+    showUnderline: boolean
+    text: string
+    textElementRef: RefObject<HTMLElement>
+    textWrapperRef: RefObject<HTMLElement>
+}
+
+const LINE_TEXT_GAP_PX = 2
+const LINE_RECT_EPSILON_PX = 0.5
+const LINE_TOP_EPSILON_PX = 1
+
+export const areLineRectsEqual = (currentRects: InlineLineRect[], nextRects: InlineLineRect[]) =>
+    currentRects.length === nextRects.length &&
+    currentRects.every((rect, index) => {
+        const nextRect = nextRects[index]
+
+        return (
+            nextRect &&
+            Math.abs(rect.left - nextRect.left) <= LINE_RECT_EPSILON_PX &&
+            Math.abs(rect.top - nextRect.top) <= LINE_RECT_EPSILON_PX &&
+            Math.abs(rect.width - nextRect.width) <= LINE_RECT_EPSILON_PX
+        )
+    })
+
+// Прямоугольники строк текста относительно контейнера: по одному на каждую визуальную строку переноса
+export const getTextLineRects = (textElement: HTMLElement, contentElement: HTMLElement): InlineLineRect[] => {
+    const range = document.createRange()
+
+    if (!range.getClientRects) {
+        return []
+    }
+
+    range.selectNodeContents(textElement)
+
+    const contentRect = contentElement.getBoundingClientRect()
+    const rects = [...range.getClientRects()]
+        .filter((rect) => rect.width > 0 && rect.height > 0)
+        .sort((a, b) => (Math.abs(a.top - b.top) > LINE_TOP_EPSILON_PX ? a.top - b.top : a.left - b.left))
+    const groupedRects: Array<{ top: number; bottom: number; left: number; right: number }> = []
+
+    rects.forEach((rect) => {
+        const lastRect = groupedRects[groupedRects.length - 1]
+
+        if (lastRect && Math.abs(lastRect.top - rect.top) <= LINE_TOP_EPSILON_PX) {
+            lastRect.bottom = Math.max(lastRect.bottom, rect.bottom)
+            lastRect.left = Math.min(lastRect.left, rect.left)
+            lastRect.right = Math.max(lastRect.right, rect.right)
+            return
+        }
+
+        groupedRects.push({
+            top: rect.top,
+            bottom: rect.bottom,
+            left: rect.left,
+            right: rect.right
+        })
+    })
+
+    return groupedRects.map((rect) => ({
+        left: rect.left - contentRect.left,
+        top: rect.bottom - contentRect.top + LINE_TEXT_GAP_PX,
+        width: rect.right - rect.left
+    }))
+}
+
+// Измеряет строки текста, чтобы нарисовать прямую линию под каждой строкой переноса
+export const useInlineUnderline = ({
+    showUnderline,
+    text,
+    textElementRef,
+    textWrapperRef
+}: UseInlineUnderlineParams) => {
+    const [lineRects, setLineRects] = useState<InlineLineRect[]>([])
+
+    const updateLineRects = useCallback(() => {
+        if (!showUnderline || !textWrapperRef.current || !textElementRef.current) {
+            setLineRects((currentRects) => (currentRects.length === 0 ? currentRects : []))
+            return
+        }
+
+        const nextRects = getTextLineRects(textElementRef.current, textWrapperRef.current)
+
+        setLineRects((currentRects) => (areLineRectsEqual(currentRects, nextRects) ? currentRects : nextRects))
+    }, [showUnderline, textElementRef, textWrapperRef])
+
+    useLayoutEffect(() => {
+        let isActive = true
+        let animationFrameId: number | undefined
+
+        const scheduleLineRectsUpdate = () => {
+            if (!isActive) {
+                return
+            }
+
+            if (animationFrameId !== undefined) {
+                cancelAnimationFrame(animationFrameId)
+            }
+
+            animationFrameId = requestAnimationFrame(updateLineRects)
+        }
+
+        scheduleLineRectsUpdate()
+
+        const observedElement = textWrapperRef.current
+
+        if (!showUnderline || !observedElement) {
+            return () => {
+                isActive = false
+
+                if (animationFrameId !== undefined) {
+                    cancelAnimationFrame(animationFrameId)
+                }
+            }
+        }
+
+        const resizeObserver =
+            typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(scheduleLineRectsUpdate)
+
+        resizeObserver?.observe(observedElement)
+        window.addEventListener('resize', scheduleLineRectsUpdate)
+
+        if ('fonts' in document) {
+            void (async () => {
+                await document.fonts.ready
+                scheduleLineRectsUpdate()
+            })()
+        }
+
+        return () => {
+            isActive = false
+            resizeObserver?.disconnect()
+            window.removeEventListener('resize', scheduleLineRectsUpdate)
+
+            if (animationFrameId !== undefined) {
+                cancelAnimationFrame(animationFrameId)
+            }
+        }
+    }, [showUnderline, text, textWrapperRef, updateLineRects])
+
+    return { lineRects }
+}
