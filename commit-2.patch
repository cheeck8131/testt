+            render(<SendMessage data={data} />)
+
+            expect(mocks.getExternalMethod).not.toHaveBeenCalled()
+            expect(checkActiveMethod).not.toHaveBeenCalled()
+            expect(screen.getByRole('button', { name: data.text })).toBeDisabled()
+        })
+    })
+})
