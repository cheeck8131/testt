+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { Link } from './link'
+import { examples } from './link.examples'
+import { PayloadDataSchema } from './link.schema'
+
+const mocks = vi.hoisted(() => ({ action: vi.fn(), loading: false }))
+
+vi.mock('#/hooks', () => ({
+    useSystemActions: () => ({ action: mocks.action, loading: mocks.loading })
+}))
+
+const getExample = (name: string) => {
+    const example = examples.find((item) => item.name === name)
+
+    if (!example) {
+        throw new Error(`Пример ${name} не найден`)
+    }
+
+    return example.params
+}
+
+describe('Link', () => {
+    beforeEach(() => {
+        mocks.action.mockReset()
+        mocks.loading = false
+    })
+
+    it('все примеры проходят схему', () => {
+        examples.forEach((example) => {
+            expect(PayloadDataSchema.safeParse(example.params).success, example.name).toBe(true)
+        })
+    })
+
+    it('открывает URL по нажатию через системное действие deeplink', () => {
+        const data = getExample('LinkDefault')
+
+        render(<Link data={data} />)
+        fireEvent.click(screen.getByRole('link', { name: data.text }))
+
+        expect(mocks.action).toHaveBeenCalledTimes(1)
+        expect(mocks.action).toHaveBeenCalledWith({ type: 'deeplink', from: 'link', payload: { url: data.url } })
+    })
+
+    it('с action выполняет его вместо перехода по url', () => {
+        const data = getExample('LinkWithAction')
+
+        render(<Link data={data} />)
+        fireEvent.click(screen.getByRole('link', { name: data.text }))
+
+        expect(mocks.action).toHaveBeenCalledTimes(1)
+        expect(mocks.action).toHaveBeenCalledWith({
+            type: 'externalMethod',
+            from: 'link',
+            payload: {
+                externalMethodSettings: {
+                    methodName: 'openDepositForm',
+                    methodParams: { productCode: 'SberVklad' },
+                    callbackType: 'none'
+                }
+            }
+        })
+    })
+
+    it('action message уходит в чат с inputType widget', () => {
+        render(
+            <Link
+                data={{
+                    text: 'условия вклада',
+                    url: 'https://www.sberbank.ru/ru/person/contributions/deposits',
+                    action: { type: 'message', payload: { text: 'Расскажи об условиях вклада' } }
+                }}
+            />
+        )
+        fireEvent.click(screen.getByRole('link', { name: 'условия вклада' }))
+
+        expect(mocks.action).toHaveBeenCalledWith({
+            type: 'message',
+            from: 'link',
+            payload: { text: 'Расскажи об условиях вклада', inputType: 'widget' }
+        })
+    })
+
+    it('без icon показывает стрелку слева от текста', () => {
+        const { container } = render(<Link data={getExample('LinkDefault')} />)
+
+        expect(container.querySelector('[aria-hidden="true"] svg')).toBeInTheDocument()
+        expect(container.querySelector('img')).not.toBeInTheDocument()
+    })
+
+    it('с icon по URL показывает картинку вместо стрелки', () => {
+        const { container } = render(<Link data={getExample('LinkWithImage')} />)
+
+        expect(container.querySelector('img')).toHaveAttribute(
+            'src',
+            'https://web-si20.sberbank.ru:1443/images/company_logo_small/7205_small.png'
+        )
+    })
+
+    it('не отправляет повторный переход, пока выполняется предыдущий', () => {
+        mocks.loading = true
+        const data = getExample('LinkDefault')
+
+        render(<Link data={data} />)
+        fireEvent.click(screen.getByRole('link', { name: data.text }))
+
+        expect(mocks.action).not.toHaveBeenCalled()
+    })
+})
