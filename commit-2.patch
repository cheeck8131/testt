@@ -0,0 +1,102 @@
+import { useRef, type ReactNode } from 'react'
+import clsx from 'clsx'
+
+import Styles from './inline-element.module.css'
+import { useInlineUnderline } from './use-inline-underline'
+
+export type InlineElementProps = {
+    /** Основной текст элемента */
+    text: string
+    /** Узел слева от текста в квадрате --icon-size-s: иконка или картинка. Скрыт от скринридеров */
+    leading?: ReactNode
+    /** Узел сразу после текста в той же строке, например изменение котировки */
+    trailing?: ReactNode
+    /** Рисует прямую линию под каждой строкой текста */
+    underline?: boolean
+    /** Обработчик нажатия. Если передан, элемент рендерится как button */
+    onClick?: () => void
+    /** Блокирует нажатие. Внешний вид задаёт виджет через CSS-переменные */
+    disabled?: boolean
+    /** Роль кнопки, если по смыслу это ссылка */
+    role?: 'link'
+    /** Класс корневого элемента, через него виджет задаёт CSS-переменные цвета */
+    className?: string
+}
+
+/**
+ * Базовый строчный элемент inline-виджетов: иконка слева, подчёркнутый текст
+ * и дополнительный узел справа. Иконка стоит в отдельной колонке, строки переноса выравниваются
+ * по началу текста; линия прямая, по макету.
+ *
+ * Цвета переопределяются CSS-переменными на `className`:
+ * - `--inline-element-text-color` — текст, по умолчанию `--color-text-standard-general-primary`;
+ * - `--inline-element-leading-color` — иконка слева, по умолчанию `--color-icon-standard-general-primary`;
+ * - `--inline-element-line-color` — линия, по умолчанию `--color-stroke-standard-general-secondary`.
+ */
+export const InlineElement = ({
+    text,
+    leading,
+    trailing,
+    underline = false,
+    onClick,
+    disabled = false,
+    role,
+    className
+}: InlineElementProps) => {
+    const textWrapperRef = useRef<HTMLSpanElement>(null)
+    const textRef = useRef<HTMLSpanElement>(null)
+    const { lineRects } = useInlineUnderline({
+        showUnderline: underline,
+        text,
+        textElementRef: textRef,
+        textWrapperRef
+    })
+    const rootClassName = clsx(
+        Styles.root,
+        underline && Styles.withUnderline,
+        onClick && !disabled && Styles.clickable,
+        className
+    )
+
+    const lineNodes = underline
+        ? lineRects.map((lineRect) => (
+              <span
+                  key={[Math.round(lineRect.left), Math.round(lineRect.top), Math.round(lineRect.width)].join('-')}
+                  aria-hidden="true"
+                  className={Styles.line}
+                  style={{
+                      left: lineRect.left,
+                      top: lineRect.top,
+                      width: lineRect.width
+                  }}
+              />
+          ))
+        : null
+
+    const content = (
+        <span className={Styles.content}>
+            {leading ? (
+                <span aria-hidden="true" className={Styles.leading}>
+                    {leading}
+                </span>
+            ) : null}
+            <span className={Styles.textWrapper} ref={textWrapperRef}>
+                <span className={Styles.text} ref={textRef}>
+                    {text}
+                </span>
+                {trailing ? <span className={Styles.trailing}>{trailing}</span> : null}
+                {lineNodes}
+            </span>
+        </span>
+    )
+
+    if (onClick) {
+        return (
+            <button type="button" role={role} className={rootClassName} disabled={disabled} onClick={onClick}>
+                {content}
+            </button>
+        )
+    }
+
+    return <span className={rootClassName}>{content}</span>
+}
