+import { useCallback, useRef } from 'react'
+
+import SendMessageIcon from '#/assets/components/send-message-icon'
+import { useSystemActions, useWidgetActive } from '#/hooks'
+import { InlineElement, normalizeInlineAction } from '#/parts/inline-element'
+import { widget, type Widget } from '#/system'
+
+import { useCheckActive } from './hooks/use-check-active'
+import Styles from './send-message.module.css'
+import { type PayloadData } from './send-message.schema'
+
+export const SendMessage: Widget<PayloadData> = ({ data }) => {
+    const { action, loading } = useSystemActions()
+    const { isActive: isWidgetActive, setDisabled } = useWidgetActive()
+    // Хост проверяет активность, только пока виджет не выключен сообщением или inactiveAfterSend
+    const { status: checkStatus, recheck } = useCheckActive(data.checkActive, isWidgetActive)
+    const isActive = isWidgetActive && checkStatus === 'active'
+    // Блокирует повторную отправку сразу, не дожидаясь ре-рендера после setDisabled
+    const isSentRef = useRef(false)
+
+    const send = useCallback(async () => {
+        if (!isActive || loading || (data.inactiveAfterSend && isSentRef.current)) {
+            return
+        }
+
+        if (data.inactiveAfterSend) {
+            isSentRef.current = true
+            setDisabled(true)
+        }
+
+        await action(
+            normalizeInlineAction(data.action ?? { type: 'message', payload: { text: data.text } }, {
+                from: 'send_message',
+                inputType: 'widget'
+            })
+        )
+
+        // Действие могло изменить событие на стороне хоста: уточняем, активно ли оно теперь.
+        // С inactiveAfterSend действие уже выключено навсегда, проверка не нужна
+        if (data.checkActive && !data.inactiveAfterSend) {
+            await recheck()
+        }
+    }, [
+        action,
+        data.action,
+        data.checkActive,
+        data.inactiveAfterSend,
+        data.text,
+        isActive,
+        loading,
+        recheck,
+        setDisabled
+    ])
+
+    const handleClick = useCallback(() => {
+        void send()
+    }, [send])
+
+    return (
+        <InlineElement
+            text={data.text}
+            leading={<SendMessageIcon />}
+            underline
+            disabled={!isActive || loading}
+            className={isActive ? undefined : Styles.inactive}
+            onClick={handleClick}
+        />
+    )
+}
+
+export default widget(SendMessage, { withModule: false, wrapperElement: 'span' })
