+    type: z.literal('url'),
+    url: z
+        .string()
+        .describe('URL картинки: логотип компании или сервиса. Отображается кругом 16×16 слева от текста')
+})
+
+const InlineIconByNameSchema = z.object({
+    type: z.literal('name'),
+    name: z.enum(SYSTEM_ICON_NAMES).describe('Название системной иконки')
+})
+
+/** Иконка слева от текста inline-виджета: картинка по URL или системная иконка по имени */
+export const InlineIconSchema = z.discriminatedUnion('type', [InlineIconByUrlSchema, InlineIconByNameSchema])
+
+export type InlineIconData = z.infer<typeof InlineIconSchema>
+
+const ArbitraryObjectSchema = z.object({}).passthrough()
+
+const MessageAction = z.object({
+    type: z.literal('message'),
+    payload: z.object({
+        text: z.string().describe('Текст сообщения, которое будет отправлено в чат'),
+        content: z.string().optional().nullable().describe('Опциональный content для function_results')
+    })
+})
+
+const LegacySendMessageAction = z.object({
+    type: z.literal('sendMessage'),
+    payload: z.object({
+        text: z.string().describe('Текст сообщения, которое будет отправлено в чат'),
+        content: z.string().optional().nullable().describe('Опциональный content для function_results')
+    })
+})
+
+const DeeplinkAction = z.object({
+    type: z.literal('deeplink'),
+    payload: z.object({
+        url: z.string().describe('URL или deeplink для открытия')
+    })
+})
+
+const ExternalMethodAction = z.object({
+    type: z.literal('externalMethod'),
+    payload: z.object({
+        externalMethodSettings: z.object({
+            methodName: z.string().describe('Название внешнего метода'),
+            methodParams: ArbitraryObjectSchema.describe('Параметры внешнего метода'),
+            callbackType: z
+                .enum([
+                    'none',
+                    'message',
+                    'deeplink',
+                    'externalMethod',
+                    'sendMessage'
+                ])
+                .optional()
+                .default('none')
+                .describe('Тип callback-действия после выполнения внешнего метода')
+        })
+    })
+})
+
+/**
+ * Действие по нажатию на inline-виджет: message, deeplink или externalMethod.
+ * Общий контракт виджетов inline, link и send-message; legacy-тип sendMessage сохранён как алиас message
+ */
+export const InlineActionSchema = z.discriminatedUnion('type', [
+    MessageAction,
+    LegacySendMessageAction,
+    DeeplinkAction,
+    ExternalMethodAction
+])
+
+export type InlineAction = z.infer<typeof InlineActionSchema>
