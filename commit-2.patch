+import { IGetExternalMethod, type IGetExternalMethod as GetExternalMethod } from '@sbol/asdk-core'
+import type { Decorator, Meta } from '@storybook/react'
+import { useState, type ReactNode } from 'react'
+
+import {
+    buildArgTypesFromZod,
+    createFullWidgetMetaStory,
+    createStoriesFromExamples,
+    createWidgetMetaStoryWithSchema,
+    extractSchemaDescription
+} from '#/storybook'
+
+import SendMessage from './send-message'
+import { examples } from './send-message.examples'
+import { widgetMeta } from './send-message.meta'
+import { PayloadDataSchema } from './send-message.schema'
+
+const schemaDescription = extractSchemaDescription(PayloadDataSchema)
+const ExternalMethodProvider = IGetExternalMethod.context.Provider
+// Задержка ответа хоста, чтобы в Storybook было видно состояние проверки
+const HOST_RESPONSE_DELAY = 1000
+
+const wait = (delay: number): Promise<void> =>
+    new Promise((resolve) => {
+        setTimeout(resolve, delay)
+    })
+
+/**
+ * Мок хоста: checkActiveId отвечает строкой "true"/"false", как часть реальных хостов,
+ * confirmEvent обрабатывает событие, после чего оно становится неактивным
+ */
+const createHostMock = (isEventActiveInitially: boolean): GetExternalMethod => {
+    let isEventActive = isEventActiveInitially
+
+    const getExternalMethod: GetExternalMethod = async (methodName) => {
+        if (methodName === 'checkActiveId') {
+            return async () => {
+                await wait(HOST_RESPONSE_DELAY)
+
+                return String(isEventActive)
+            }
+        }
+
+        if (methodName === 'confirmEvent') {
+            return async () => {
+                await wait(HOST_RESPONSE_DELAY)
+                isEventActive = false
+
+                return undefined
+            }
+        }
+
+        return undefined
+    }
+
+    return getExternalMethod
+}
+
+const HostMock = ({ isEventActive, children }: { isEventActive: boolean; children: ReactNode }) => {
+    const [getExternalMethod] = useState(() => createHostMock(isEventActive))
+
+    return <ExternalMethodProvider value={getExternalMethod}>{children}</ExternalMethodProvider>
+}
+
+const withHostMock =
+    (isEventActive: boolean): Decorator =>
+    (Story) => (
+        <HostMock isEventActive={isEventActive}>
+            <Story />
+        </HostMock>
+    )
+
+const meta = {
+    title: 'widgets/SendMessage',
+    component: SendMessage,
+    argTypes: buildArgTypesFromZod(PayloadDataSchema),
+    parameters: {
+        layout: 'centered',
+        docs: {
+            description: {
+                component: `[Макет в Pixso](${widgetMeta.pixsoLink})\n\n${schemaDescription}`
+            }
+        }
+    }
+} satisfies Meta<typeof SendMessage>
+
+export default meta
+
+const generatedStories = createStoriesFromExamples(examples, PayloadDataSchema)
+
+export const SendMessageDefault = generatedStories.SendMessageDefault
+export const SendMessageWithContent = generatedStories.SendMessageWithContent
+export const SendMessageTextAsMessage = generatedStories.SendMessageTextAsMessage
+export const SendMessageInactiveAfterSend = generatedStories.SendMessageInactiveAfterSend
+export const SendMessageLongText = generatedStories.SendMessageLongText
+
+// Хост отвечает "true": действие неактивно на время проверки, затем активируется
+export const SendMessageCheckActive = {
+    ...generatedStories.SendMessageCheckActive,
+    decorators: [withHostMock(true)]
+}
+
+// Хост отвечает "false": событие устарело, действие остаётся неактивным
+export const SendMessageCheckActiveFalse = {
+    ...generatedStories.SendMessageCheckActive,
+    decorators: [withHostMock(false)]
+}
+
+// После confirmEvent повторная проверка возвращает "false" и действие становится неактивным
+export const SendMessageExternalMethodCheckActive = {
+    ...generatedStories.SendMessageExternalMethodCheckActive,
+    decorators: [withHostMock(true)]
+}
+
+// Неактивное состояние: сообщение устарело или действие уже выполнено
+export const SendMessageInactive = {
+    ...generatedStories.SendMessageTextAsMessage,
+    args: {
+        ...generatedStories.SendMessageTextAsMessage.args,
+        isActive: false
+    }
+}
+
+export const WidgetMetadata = createWidgetMetaStoryWithSchema(widgetMeta, PayloadDataSchema)
+
+export const GeneratedWidgetMetaJson = createFullWidgetMetaStory({
+    toolName: 'send_message',
+    widgetMeta,
+    schema: PayloadDataSchema,
+    stories: Object.values(generatedStories)
+})
