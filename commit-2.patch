+import { fireEvent, render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+
+import { InlineElement } from './inline-element'
+import Styles from './inline-element.module.css'
+import { areLineRectsEqual } from './use-inline-underline'
+
+describe('InlineElement', () => {
+    it('без onClick рендерится как текст, а не кнопка', () => {
+        const { container } = render(<InlineElement text="Сбербанк" trailing="2,4%" />)
+
+        expect(screen.queryByRole('button')).not.toBeInTheDocument()
+        expect(container.firstElementChild?.tagName).toBe('SPAN')
+        expect(screen.getByText('2,4%')).toHaveClass(Styles.trailing)
+    })
+
+    it('с onClick рендерится кнопкой и вызывает обработчик', () => {
+        const onClick = vi.fn()
+
+        render(<InlineElement text="проанализировать траты" underline onClick={onClick} />)
+        const button = screen.getByRole('button', { name: 'проанализировать траты' })
+
+        fireEvent.click(button)
+
+        expect(onClick).toHaveBeenCalledTimes(1)
+        expect(button).toHaveClass(Styles.clickable)
+        expect(button).toHaveClass(Styles.withUnderline)
+    })
+
+    it('заблокированный элемент не вызывает обработчик и не получает hover-состояние', () => {
+        const onClick = vi.fn()
+
+        render(<InlineElement text="Рейтинг" role="link" disabled onClick={onClick} />)
+        const link = screen.getByRole('link', { name: 'Рейтинг' })
+
+        fireEvent.click(link)
+
+        expect(onClick).not.toHaveBeenCalled()
+        expect(link).not.toHaveClass(Styles.clickable)
+    })
+
+    it('скрывает иконку слева от скринридеров', () => {
+        const { container } = render(<InlineElement text="Рейтинг" leading={<svg data-testid="icon" />} />)
+
+        expect(container.querySelector(`.${Styles.leading}`)).toHaveAttribute('aria-hidden', 'true')
+    })
+})
+
+describe('areLineRectsEqual', () => {
+    it('считает строки равными с точностью до полупикселя', () => {
+        expect(areLineRectsEqual([{ left: 0, top: 24, width: 100 }], [{ left: 0.4, top: 24.2, width: 100.5 }])).toBe(
+            true
+        )
+        expect(areLineRectsEqual([{ left: 0, top: 24, width: 100 }], [{ left: 0, top: 30, width: 100 }])).toBe(false)
+        expect(areLineRectsEqual([{ left: 0, top: 24, width: 100 }], [])).toBe(false)
+    })
+})
