+import type { TicketKind } from './inline-ticket.schema'
+
+/** Текст состояния, когда котировка не получена */
+export const ERROR_TEXT = 'Данные не пришли'
+
+const TREND_LABEL: Partial<Record<TicketKind, string>> = {
+    Positive: 'рост',
+    Negative: 'падение'
+}
+
+/**
+ * Подпись стрелки направления для скринридеров: цвет и стрелка не озвучиваются,
+ * поэтому направление изменения передаётся словом перед значением.
+ * @param {TicketKind} kind - направление изменения котировки
+ * @returns {string | undefined} «рост», «падение» или undefined, если стрелки нет
+ */
+export const getTrendLabel = (kind: TicketKind): string | undefined => TREND_LABEL[kind]
