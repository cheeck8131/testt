+import { z } from 'zod'
+
+import { InlineIconSchema } from '#/parts/inline-element/inline-element.schema'
+
+export const TicketKindSchema = z.enum(['Neutral', 'Positive', 'Negative', 'Error'])
+
+export const PayloadDataSchema = z
+    .object({
+        text: z.string().describe('Название компании или тикер ценной бумаги, например «Сбербанк» или «SBER»'),
+        change: z
+            .string()
+            .optional()
+            .describe(
+                'Изменение цены без знака, например «2,4%». Направление задаётся полем kind. ' +
+                    'Если не передано, вместо котировки показывается «Данные не пришли»'
+            ),
+        kind: TicketKindSchema.optional().describe(
+            'Направление изменения: Neutral — без изменений, Positive — рост (зелёный текст и стрелка вверх), ' +
+                'Negative — падение (красный текст и стрелка вниз), Error — данные о котировке не получены. По умолчанию Neutral'
+        ),
+        icon: InlineIconSchema.optional().describe('Логотип компании или иконка слева от названия')
+    })
+    .describe(
+        'Котировка ценной бумаги внутри текста ответа: логотип, название или тикер и изменение цены, ' +
+            'окрашенное по направлению динамики'
+    )
+
+export type TicketKind = z.infer<typeof TicketKindSchema>
+export type PayloadData = z.infer<typeof PayloadDataSchema>
