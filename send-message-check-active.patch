+import { act, renderHook, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { parseCheckActiveResponse, useCheckActive } from './use-check-active'
+
+const mocks = vi.hoisted(() => ({ getExternalMethod: null as unknown }))
+
+vi.mock('#/hooks', () => ({
+    useGetExternalMethod: () => mocks.getExternalMethod
+}))
+
+const CHECK_ACTIVE = { methodName: 'checkActiveId', methodParams: { eventId: '1234567' } }
+
+const createDeferred = <T>() => {
+    let resolve: (value: T) => void = () => undefined
+    const promise = new Promise<T>((res) => {
+        resolve = res
+    })
+
+    return { promise, resolve }
+}
+
+describe('parseCheckActiveResponse', () => {
+    it.each([
+        [true, true],
+        [false, false],
+        ['true', true],
+        ['false', false],
+        [' FALSE ', false],
+        ['False', false],
+        [' True ', true]
+    ])('ответ %j → %s', (response, expected) => {
+        expect(parseCheckActiveResponse(response)).toBe(expected)
+    })
+
+    it.each([[undefined], [null], [''], ['да'], [0], [1], [{ isActive: false }]])(
+        'пустой или непонятный ответ %j считается активным',
+        (response) => {
+            expect(parseCheckActiveResponse(response)).toBe(true)
+        }
+    )
+})
+
+describe('useCheckActive', () => {
+    beforeEach(() => {
+        mocks.getExternalMethod = null
+    })
+
+    it('без getExternalMethod сразу активен и не ждёт проверки', () => {
+        const { result } = renderHook(() => useCheckActive(CHECK_ACTIVE))
+
+        expect(result.current.status).toBe('active')
+    })
+
+    it('при enabled=false не вызывает метод', () => {
+        mocks.getExternalMethod = vi.fn()
+
+        renderHook(() => useCheckActive(CHECK_ACTIVE, false))
+
+        expect(mocks.getExternalMethod).not.toHaveBeenCalled()
+    })
+
+    it('не перезапускает проверку, если хост отдал новую функцию getExternalMethod', async () => {
+        const method = vi.fn(async () => true)
+
+        mocks.getExternalMethod = vi.fn(async () => method)
+
+        const { result, rerender } = renderHook(() => useCheckActive(CHECK_ACTIVE))
+
+        await waitFor(() => expect(result.current.status).toBe('active'))
+
+        mocks.getExternalMethod = vi.fn(async () => method)
+        rerender()
+
+        expect(result.current.status).toBe('active')
+        expect(method).toHaveBeenCalledTimes(1)
+    })
+
+    it('применяет только ответ последнего запроса', async () => {
+        const first = createDeferred<unknown>()
+        const second = createDeferred<unknown>()
+        const method = vi.fn().mockReturnValueOnce(first.promise).mockReturnValueOnce(second.promise)
+
+        mocks.getExternalMethod = vi.fn(async () => method)
+
+        const { result } = renderHook(() => useCheckActive(CHECK_ACTIVE))
+
+        await waitFor(() => expect(method).toHaveBeenCalledTimes(1))
+
+        act(() => {
+            void result.current.recheck()
+        })
+        await waitFor(() => expect(method).toHaveBeenCalledTimes(2))
+
+        // Свежий ответ приходит раньше устаревшего
+        await act(async () => {
+            second.resolve(true)
+        })
+        await act(async () => {
+            first.resolve(false)
+        })
+
+        expect(result.current.status).toBe('active')
+    })
+})
