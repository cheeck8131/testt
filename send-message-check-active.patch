+/* eslint-disable no-console */
+import { useCallback, useEffect, useRef, useState } from 'react'
+
+import { useGetExternalMethod } from '#/hooks'
+
+import { type CheckActive } from '../send-message.schema'
+
+/**
+ * Состояние проверки активности:
+ * - `checking` — запрос к внешнему методу ещё выполняется, действие неактивно;
+ * - `active` — хост разрешил действие или проверить его не удалось;
+ * - `inactive` — хост ответил false.
+ */
+export type CheckActiveStatus = 'checking' | 'active' | 'inactive'
+
+/**
+ * Приводит ответ внешнего метода к признаку активности.
+ * Хост может вернуть boolean или строку "true"/"false". Неактивным действие становится
+ * только при явном false: пустой или непонятный ответ считается активным.
+ */
+export const parseCheckActiveResponse = (response: unknown): boolean => {
+    if (typeof response === 'boolean') {
+        return response
+    }
+
+    if (typeof response === 'string') {
+        return response.trim().toLowerCase() !== 'false'
+    }
+
+    return true
+}
+
+/**
+ * Проверяет через внешний метод хоста, активно ли действие.
+ * Без `checkActive` или без getExternalMethod действие активно сразу, без запроса.
+ * Проверка запускается при монтировании, пока `enabled` равно true; `recheck` повторяет её вручную,
+ * например после отправки сообщения. Применяется только ответ последнего запроса.
+ */
+export const useCheckActive = (checkActive: CheckActive | undefined, enabled = true) => {
+    const getExternalMethod = useGetExternalMethod()
+    const methodName = checkActive?.methodName
+    // Параметры сравниваются по значению, чтобы новый объект с теми же данными не перезапускал проверку
+    const paramsKey = JSON.stringify(checkActive?.methodParams ?? {})
+    const hasExternalMethod = Boolean(getExternalMethod)
+    const [status, setStatus] = useState<CheckActiveStatus>(methodName && hasExternalMethod ? 'checking' : 'active')
+    const requestIdRef = useRef(0)
+    // Хост может отдавать новую функцию на каждом рендере: держим её в ref, чтобы не перезапускать проверку
+    const getExternalMethodRef = useRef(getExternalMethod)
+
+    useEffect(() => {
+        getExternalMethodRef.current = getExternalMethod
+    }, [getExternalMethod])
+
+    const recheck = useCallback(async () => {
+        const getMethod = getExternalMethodRef.current
+
+        if (!methodName || !getMethod) {
+            setStatus('active')
+            return
+        }
+
+        requestIdRef.current += 1
+        const requestId = requestIdRef.current
+        let isActive = true
+
+        setStatus('checking')
+
+        try {
+            const method = await getMethod(methodName)
+
+            if (method) {
+                isActive = parseCheckActiveResponse(await method(JSON.parse(paramsKey)))
+            } else {
+                console.error(`Внешний метод ${methodName} не найден, действие считается активным`)
+            }
+        } catch (error: unknown) {
+            console.error(error)
+        }
+
+        // Более поздний запрос или размонтирование отменяют этот ответ
+        if (requestId === requestIdRef.current) {
+            setStatus(isActive ? 'active' : 'inactive')
+        }
+    }, [methodName, paramsKey])
+
+    useEffect(() => {
+        if (!enabled) {
+            return undefined
+        }
+
+        void recheck()
+
+        return () => {
+            requestIdRef.current += 1
+        }
+        // Проверка перезапускается, если хост начал или перестал поддерживать внешние методы
+    }, [enabled, hasExternalMethod, recheck])
+
+    return { status, recheck }
+}
